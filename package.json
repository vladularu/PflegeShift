{
  "name": "pflegeshift",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint app src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:components": "jest --runInBand",
    "test:all": "npm run test && npm run test:components && npm run test:audit-policy",
    "test:audit-policy": "node --test scripts/audit-production.test.mjs",
    "test:coverage": "vitest run --coverage --exclude src/features/analysis/monthly-compliance-performance.test.ts",
    "audit:production": "node scripts/audit-production.mjs",
    "release:check": "node scripts/verify-release-config.mjs",
    "assets": "node scripts/generate-brand-assets.mjs",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.10",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-updates": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@<=1.1.17": "1.1.18",
    "brace-expansion@2.0.0 - 2.1.3": "2.1.4",
    "brace-expansion@4.0.0 - 5.0.8": "5.0.9",
    "js-yaml@3.0.0 - 3.15.0": "3.15.1",
    "js-yaml@4.0.0 - 4.3.0": "4.3.1",
    "nanoid@<3.3.18": "3.3.18",
    "postcss@<=8.5.22": "8.5.25"
  },
  "private": true
}
