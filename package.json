{
  "name": "medishift",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint app src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:components": "jest --runInBand",
    "test:all": "npm run test && npm run test:components",
    "test:coverage": "vitest run --coverage --exclude src/features/analysis/monthly-compliance-performance.test.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "release:check": "node scripts/verify-release-config.mjs",
    "assets": "node scripts/generate-brand-assets.mjs",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-symbols": "~1.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@<=1.1.17": "1.1.18",
    "brace-expansion@2.0.0 - 2.1.3": "2.1.4",
    "brace-expansion@4.0.0 - 5.0.8": "5.0.9",
    "postcss@<=8.5.22": "8.5.25"
  },
  "private": true
}
