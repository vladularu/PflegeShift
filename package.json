{
  "name": "pflegeshift",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint app src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run src/rules/validation.test.ts",
    "test:components": "jest --runInBand",
    "test:all": "npm run test && npm run test:components && npm run test:rules-publisher && npm run test:rules-delivery && npm run test:rules-production-preflight && npm run test:rules-production-provisioning && npm run test:rules-production-trust && npm run test:rules-operator && npm run test:audit-policy && npm run test:runtime-policy",
    "test:rules-publisher": "node --import tsx --test scripts/publish-rule-catalog.test.mjs",
    "test:rules-delivery": "node --import tsx --test scripts/deliver-rule-catalog.test.mjs",
    "test:rules-production-preflight": "node --import tsx --test scripts/production-rule-catalog-preflight.test.mjs",
    "test:rules-production-provisioning": "node --import tsx --test scripts/production-rule-catalog-provisioning-operator.test.mjs",
    "test:rules-production-trust": "node --import tsx --test scripts/production-rule-catalog-trust-operator.test.mjs",
    "test:rules-operator": "node --import tsx --test scripts/preview-rule-catalog-operator.test.mjs",
    "test:audit-policy": "node --test scripts/audit-production.test.mjs",
    "test:runtime-policy": "node --test scripts/runtime-policy.test.mjs",
    "test:coverage:unit": "vitest run --coverage --exclude src/features/analysis/monthly-compliance-performance.test.ts",
    "test:coverage:components": "jest --runInBand --coverage",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:components",
    "audit:production": "node scripts/audit-production.mjs",
    "rules:generate": "node scripts/generate-rule-contracts.mjs",
    "rules:validate": "node --import tsx scripts/validate-rule-packages.mjs",
    "rules:publish": "node --import tsx scripts/publish-rule-catalog.mjs",
    "rules:deliver": "node --import tsx scripts/deliver-rule-catalog.mjs",
    "rules:production:preflight": "node --import tsx scripts/production-rule-catalog-preflight.mjs",
    "rules:production:provisioning": "node --import tsx scripts/production-rule-catalog-provisioning-operator.mjs",
    "rules:production:trust": "node --import tsx scripts/production-rule-catalog-trust-operator.mjs",
    "rules:preview:recover": "node --import tsx scripts/preview-rule-catalog-operator.mjs recover",
    "rules:preview:prepare": "node --import tsx scripts/preview-rule-catalog-operator.mjs prepare",
    "rules:preview:preflight": "node --import tsx scripts/preview-rule-catalog-operator.mjs preflight",
    "rules:preview:activate": "node --import tsx scripts/preview-rule-catalog-operator.mjs activate",
    "rules:preview:verify": "node --import tsx scripts/preview-rule-catalog-operator.mjs verify",
    "rules:check": "node scripts/generate-rule-contracts.mjs --check && npm run rules:validate",
    "release:check": "node scripts/verify-release-config.mjs",
    "workflow:setup": "node scripts/setup-git-hooks.mjs",
    "verify:fast": "npm run rules:check && npm run typecheck && npm run lint -- --max-warnings 0 && npm run format:check && npm run test:all && git diff --check",
    "verify:full": "npm run verify:fast && npm run test:coverage && npm run audit:production && npm run release:check && npm run export:web && npm run export:android && npm run export:ios",
    "assets": "node scripts/generate-brand-assets.mjs",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@noble/ed25519": "3.0.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "ajv": "^8.20.0",
    "canonicalize": "4.0.0",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-symbols": "~57.0.2",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@<=1.1.17": "1.1.18",
    "brace-expansion@2.0.0 - 2.1.3": "2.1.4",
    "brace-expansion@4.0.0 - 5.0.8": "5.0.9",
    "js-yaml@3.0.0 - 3.15.0": "3.15.1",
    "js-yaml@4.0.0 - 4.3.0": "4.3.1",
    "nanoid@<3.3.18": "3.3.18",
    "postcss@<=8.5.22": "8.5.25"
  },
  "private": true
}
