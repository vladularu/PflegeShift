{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pflegeshift.app/schemas/rule-package-v1.json",
  "title": "PflegeShift Rule Package",
  "description": "A typed, reviewable package of tariff, legal, or public-holiday rules. Executable code is not allowed.",
  "oneOf": [
    { "$ref": "#/$defs/tariffPackage" },
    { "$ref": "#/$defs/legalPackage" },
    { "$ref": "#/$defs/holidayPackage" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "versionIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9A-Za-z]+(?:[._-][0-9A-Za-z]+)*$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$"
    },
    "nullableDate": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/isoDate" }]
    },
    "nullableIdentifier": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }]
    },
    "nullableString": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "federalState": {
      "enum": [
        "BW",
        "BY",
        "BE",
        "BB",
        "HB",
        "HH",
        "HE",
        "MV",
        "NI",
        "NW",
        "RP",
        "SL",
        "SN",
        "ST",
        "SH",
        "TH"
      ]
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "federalStates"],
      "properties": {
        "country": { "const": "DE" },
        "federalStates": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/federalState" }
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "documentDate", "section", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "url": { "type": "string", "pattern": "^https://" },
        "documentDate": { "$ref": "#/$defs/isoDate" },
        "section": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedBy", "reviewedAt", "gitCommit"],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": { "enum": ["LEGACY_EMBEDDED", "DRAFT"] },
            "reviewedBy": { "type": "null" },
            "reviewedAt": { "type": "null" },
            "gitCommit": { "type": "null" }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": { "enum": ["REVIEWED", "PUBLISHED"] },
            "reviewedBy": { "type": "string", "minLength": 1, "maxLength": 120 },
            "reviewedAt": { "$ref": "#/$defs/utcTimestamp" },
            "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          }
        }
      ],
      "properties": {
        "status": {
          "enum": ["LEGACY_EMBEDDED", "DRAFT", "REVIEWED", "PUBLISHED"]
        },
        "reviewedBy": {
          "$ref": "#/$defs/nullableString",
          "description": "Stable non-personal reviewer identifier. The solo project owner may self-review; a legal name, separate role, or second reviewer is not required."
        },
        "reviewedAt": {
          "description": "UTC timestamp recorded when the documented owner review is completed.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utcTimestamp" }]
        },
        "gitCommit": {
          "description": "Exact 40-character Git commit containing the rule content that was reviewed.",
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{40}$" }]
        }
      }
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moneyScale", "mode", "stage"],
      "properties": {
        "moneyScale": { "const": 2 },
        "mode": { "const": "HALF_UP" },
        "stage": { "enum": ["PER_LINE", "AFTER_SUM"] }
      }
    },
    "packageBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "engineContractVersion",
        "packageId",
        "versionId",
        "kind",
        "label",
        "status",
        "validFrom",
        "validTo",
        "jurisdiction",
        "sources",
        "review",
        "rounding",
        "rules"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "engineContractVersion": { "enum": [1, 2, 3, 4, 5, 6, 7, 11, 14] },
        "packageId": { "$ref": "#/$defs/identifier" },
        "versionId": { "$ref": "#/$defs/versionIdentifier" },
        "kind": { "enum": ["TARIFF", "LEGAL", "HOLIDAY"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": {
          "enum": ["LEGACY_EMBEDDED", "DRAFT", "REVIEWED", "PUBLISHED"]
        },
        "validFrom": { "$ref": "#/$defs/isoDate" },
        "validTo": { "$ref": "#/$defs/nullableDate" },
        "jurisdiction": { "$ref": "#/$defs/jurisdiction" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "review": { "$ref": "#/$defs/review" },
        "rounding": { "$ref": "#/$defs/rounding" },
        "rules": {}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresShiftTypes",
        "excludesShiftTypes",
        "payGroups",
        "sectors",
        "federalStates",
        "holidayPremiumModes",
        "allowanceStatuses",
        "monthDays"
      ],
      "properties": {
        "requiresShiftTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "excludesShiftTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "payGroups": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            }
          ]
        },
        "sectors": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["BT_K", "BT_B"] }
            }
          ]
        },
        "federalStates": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/federalState" }
            }
          ]
        },
        "tariffRegions": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["KAV_BW", "OTHER"] }
            }
          ]
        },
        "holidayPremiumModes": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["WITH_TIME_OFF", "WITHOUT_TIME_OFF"] }
            }
          ]
        },
        "allowanceStatuses": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "SHIFT_MONTHLY",
                  "SHIFT_HOURLY",
                  "ALTERNATING_MONTHLY",
                  "ALTERNATING_HOURLY"
                ]
              }
            }
          ]
        },
        "monthDays": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
              }
            }
          ]
        }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMinute", "endMinute"],
      "properties": {
        "startMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
        "endMinute": { "type": "integer", "minimum": 0, "maximum": 1439 }
      }
    },
    "payTableEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "stepId", "monthlyCents"],
      "properties": {
        "groupId": { "$ref": "#/$defs/identifier" },
        "stepId": { "$ref": "#/$defs/identifier" },
        "monthlyCents": { "type": "integer", "minimum": 0 },
        "hourlyCents": { "type": "integer", "minimum": 0 }
      }
    },
    "payTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entries", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/payTableEntry" }
        },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "overtimeBaseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumStepId", "sourceIds"],
      "properties": {
        "maximumStepId": { "$ref": "#/$defs/identifier" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "premiumRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "premiumType",
        "percentageBasisPoints",
        "rateBasis",
        "referenceStepId",
        "timeWindow",
        "conditions",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "premiumType": {
          "enum": [
            "NIGHT",
            "SUNDAY",
            "HOLIDAY_WITH_TIME_OFF",
            "HOLIDAY_WITHOUT_TIME_OFF",
            "SATURDAY",
            "PRE_HOLIDAY",
            "OVERTIME"
          ]
        },
        "percentageBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "rateBasis": { "enum": ["INDIVIDUAL_HOURLY", "TABLE_STEP"] },
        "referenceStepId": { "$ref": "#/$defs/nullableIdentifier" },
        "timeWindow": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timeWindow" }]
        },
        "conditions": { "$ref": "#/$defs/conditions" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "allowanceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "allowanceType",
        "amountKind",
        "amountCents",
        "prorateByPartTime",
        "validFrom",
        "validTo",
        "conditions",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "allowanceType": { "$ref": "#/$defs/identifier" },
        "amountKind": { "enum": ["FIXED_MONTHLY", "FIXED_HOURLY"] },
        "amountCents": { "type": "integer", "minimum": 0 },
        "prorateByPartTime": { "type": "boolean" },
        "validFrom": { "$ref": "#/$defs/isoDate" },
        "validTo": { "$ref": "#/$defs/nullableDate" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "combinationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "memberRuleIds", "mode", "priorityRuleIds", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "memberRuleIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "mode": { "enum": ["STACK", "EXCLUSIVE_HIGHEST", "PRIORITY"] },
        "priorityRuleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "workPatternRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "comparator", "threshold", "windowDays", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "metric": {
          "enum": [
            "CONSECUTIVE_NIGHT_SHIFTS",
            "WORKED_MINUTES",
            "NIGHT_MINUTES",
            "CONSECUTIVE_WORK_DAYS"
          ]
        },
        "comparator": { "enum": ["GT", "GTE", "EQ"] },
        "threshold": { "type": "integer", "minimum": 0 },
        "windowDays": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 366 }]
        },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "workPatternPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nightWindow",
        "nightQualificationMinutes",
        "recurringNightShiftCount",
        "recurringWindowMonths",
        "regularChangeCount",
        "shiftWorkMinimumShifts",
        "shiftWorkMinimumWindows",
        "alternatingMinimumShifts",
        "alternatingMinimumWindows",
        "assessmentLookbackMonths",
        "shiftWindowBoundaries",
        "sourceIds"
      ],
      "properties": {
        "nightWindow": { "$ref": "#/$defs/timeWindow" },
        "nightQualificationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "recurringNightShiftCount": { "type": "integer", "minimum": 1 },
        "recurringWindowMonths": { "type": "integer", "minimum": 1, "maximum": 24 },
        "regularChangeCount": { "type": "integer", "minimum": 1 },
        "shiftWorkMinimumShifts": { "type": "integer", "minimum": 1 },
        "shiftWorkMinimumWindows": { "type": "integer", "minimum": 1, "maximum": 4 },
        "alternatingMinimumShifts": { "type": "integer", "minimum": 1 },
        "alternatingMinimumWindows": { "type": "integer", "minimum": 1, "maximum": 4 },
        "assessmentLookbackMonths": { "type": "integer", "minimum": 0, "maximum": 24 },
        "shiftWindowBoundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nightEndMinute", "earlyEndMinute", "dayEndMinute", "nightStartMinute"],
          "properties": {
            "nightEndMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
            "earlyEndMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
            "dayEndMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
            "nightStartMinute": { "type": "integer", "minimum": 0, "maximum": 1439 }
          }
        },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "weeklyWorkingTimeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sectors", "tariffRegions", "fullTimeWeeklyMinutes", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "sectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["BT_K", "BT_B"] }
        },
        "tariffRegions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["KAV_BW", "OTHER"] }
        },
        "fullTimeWeeklyMinutes": { "type": "integer", "minimum": 60, "maximum": 4800 },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "employmentWorkingTimeRule": {
      "description": "Dated full-time basis for one explicit variant and tariff territory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "variantId",
        "regionId",
        "validFrom",
        "validTo",
        "fullTimeWeeklyMinutes",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "variantId": { "$ref": "#/$defs/selectionIdentifier" },
        "regionId": { "$ref": "#/$defs/selectionIdentifier" },
        "validFrom": { "$ref": "#/$defs/isoDate" },
        "validTo": { "$ref": "#/$defs/nullableDate" },
        "fullTimeWeeklyMinutes": { "type": "integer", "minimum": 60, "maximum": 4800 },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "caritasCareAllowanceRate": {
      "description": "Contract 14: sourced monthly care allowance rate for a provision, annex, territory and date range. A rate is not an individual entitlement or an activated calculation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provisionId",
        "variantId",
        "regionId",
        "validFrom",
        "validTo",
        "monthlyCents",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "provisionId": { "enum": ["SECTION_12_3", "SECTION_12_4"] },
        "variantId": { "$ref": "#/$defs/selectionIdentifier" },
        "regionId": { "$ref": "#/$defs/selectionIdentifier" },
        "validFrom": { "$ref": "#/$defs/isoDate" },
        "validTo": { "$ref": "#/$defs/isoDate" },
        "monthlyCents": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "hourlyCalculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monthlyFactorThousandths", "rounding", "sourceIds"],
      "properties": {
        "monthlyFactorThousandths": { "const": 4348 },
        "rounding": { "const": "HALF_UP" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "selectionIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "capabilityStatus": {
      "enum": ["SUPPORTED", "UNSUPPORTED", "NOT_APPLICABLE"]
    },
    "tariffSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "engineId", "employmentKind", "variants", "capabilities"],
      "properties": {
        "familyId": {
          "$ref": "#/$defs/identifier"
        },
        "engineId": {
          "$ref": "#/$defs/identifier"
        },
        "employmentKind": {
          "enum": ["EMPLOYEE", "APPRENTICE"]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "specialPartId", "regions", "sourceIds"],
            "properties": {
              "id": {
                "$ref": "#/$defs/selectionIdentifier"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "specialPartId": {
                "$ref": "#/$defs/identifier"
              },
              "sourceIds": {
                "$ref": "#/$defs/sourceIds"
              },
              "regions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "sourceIds"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/selectionIdentifier"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "payTableId": {
                      "$ref": "#/$defs/identifier"
                    },
                    "sourceIds": {
                      "$ref": "#/$defs/sourceIds"
                    }
                  }
                }
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basePay", "timePremiums", "allowances", "overtime", "annualPayment"],
          "properties": {
            "basePay": {
              "$ref": "#/$defs/capabilityStatus"
            },
            "timePremiums": {
              "$ref": "#/$defs/capabilityStatus"
            },
            "allowances": {
              "$ref": "#/$defs/capabilityStatus"
            },
            "overtime": {
              "$ref": "#/$defs/capabilityStatus"
            },
            "annualPayment": {
              "$ref": "#/$defs/capabilityStatus"
            }
          }
        }
      }
    },
    "annualPaymentRule": {
      "description": "Contracts 11 (VKA) and 12 (TV-L): declarative annual payment terms. Personal confirmations are not public catalog data. Policies identify bundled algorithms, never remote code.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "variantId",
        "regionIds",
        "payGroups",
        "firstEntitlementYear",
        "lastEntitlementYear",
        "rateBasisPoints",
        "referenceMonths",
        "lateEntryAfterMonth",
        "basisPolicy",
        "eligibilityPolicy",
        "reductionPolicy",
        "earlyExitBasis",
        "payoutMonth",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "variantId": {
          "$ref": "#/$defs/selectionIdentifier"
        },
        "regionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selectionIdentifier"
          }
        },
        "payGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "firstEntitlementYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 4099
        },
        "lastEntitlementYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 4099
        },
        "rateBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "referenceMonths": {
          "description": "Three reference months, or November only for TVA-L Pflege §16; semantic validation enforces the policy.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "lateEntryAfterMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "basisPolicy": {
          "enum": ["TVOED_VKA_20", "TVAOED_PFLEGE_14", "TVL_20", "TVAL_PFLEGE_16"]
        },
        "eligibilityPolicy": {
          "enum": [
            "EMPLOYED_DECEMBER_1",
            "BT_K_EARLY_EXIT",
            "TRAINING_OR_DIRECT_TAKEOVER_DECEMBER_1",
            "TVAL_TRAINING_OR_DIRECT_TAKEOVER_DECEMBER_1",
            "TVL_DECEMBER_1_OR_LEGACY_ATZ"
          ]
        },
        "reductionPolicy": {
          "enum": ["TVOED_VKA_20", "TVAOED_PFLEGE_14", "TVL_20", "TVAL_PFLEGE_16"]
        },
        "earlyExitBasis": {
          "enum": ["NONE", "LAST_FULL_MONTH_TABLE_AND_FIXED_ALLOWANCES", "LAST_THREE_MONTHS_TVL"]
        },
        "payoutMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "tariffRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "payTables",
        "premiumRules",
        "allowanceRules",
        "combinationRules",
        "workPatternRules",
        "workPatternPolicy"
      ],
      "properties": {
        "selection": {
          "$ref": "#/$defs/tariffSelection"
        },
        "annualPaymentRules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/annualPaymentRule"
          }
        },
        "selector": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["agreementId", "specialPartId", "payTableId"],
              "properties": {
                "agreementId": { "$ref": "#/$defs/identifier" },
                "specialPartId": { "$ref": "#/$defs/identifier" },
                "payTableId": { "$ref": "#/$defs/identifier" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["agreementId", "specialPartIds", "payTableId"],
              "properties": {
                "agreementId": { "$ref": "#/$defs/identifier" },
                "specialPartIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/identifier" }
                },
                "payTableId": { "$ref": "#/$defs/identifier" }
              }
            }
          ]
        },
        "payTables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/payTable" }
        },
        "overtimeBaseRule": { "$ref": "#/$defs/overtimeBaseRule" },
        "weeklyWorkingTimeRules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/weeklyWorkingTimeRule" }
        },
        "employmentWorkingTimeRules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/employmentWorkingTimeRule" }
        },
        "caritasCareAllowanceRates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/caritasCareAllowanceRate" }
        },
        "hourlyCalculation": { "$ref": "#/$defs/hourlyCalculation" },
        "premiumRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/premiumRule" }
        },
        "allowanceRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/allowanceRule" }
        },
        "combinationRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/combinationRule" }
        },
        "workPatternRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/workPatternRule" }
        },
        "workPatternPolicy": { "$ref": "#/$defs/workPatternPolicy" }
      }
    },
    "tariffPackage": {
      "allOf": [
        { "$ref": "#/$defs/packageBase" },
        {
          "type": "object",
          "required": ["kind", "rules"],
          "properties": {
            "engineContractVersion": { "enum": [1, 2, 3, 11, 14] },
            "kind": { "const": "TARIFF" },
            "rules": { "$ref": "#/$defs/tariffRules" }
          }
        }
      ]
    },
    "breakTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overMinutes", "requiredMinutes"],
      "properties": {
        "overMinutes": { "type": "integer", "minimum": 0 },
        "requiredMinutes": { "type": "integer", "minimum": 0 }
      }
    },
    "restDeviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sectorIds",
        "minimumMinutes",
        "compensationMinutes",
        "compensationWithinDays",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "sectorIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "minimumMinutes": { "type": "integer", "minimum": 0 },
        "compensationMinutes": { "type": "integer", "minimum": 0 },
        "compensationWithinDays": { "type": "integer", "minimum": 1, "maximum": 366 },
        "compensationWithinCalendarMonths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "sundayHolidayRest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibleSectorIds",
        "minimumFreeSundaysPerCalendarYear",
        "sundayCompensationPeriodDays",
        "weekdayHolidayCompensationPeriodDays",
        "replacementDayMinutes",
        "connectedRestMinutes",
        "connectionExceptionMode",
        "evidenceShiftType",
        "matchingMode",
        "sourceIds"
      ],
      "properties": {
        "eligibleSectorIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "minimumFreeSundaysPerCalendarYear": {
          "type": "integer",
          "minimum": 1,
          "maximum": 53
        },
        "sundayCompensationPeriodDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "weekdayHolidayCompensationPeriodDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "replacementDayMinutes": {
          "const": 1440
        },
        "connectedRestMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "connectionExceptionMode": { "const": "TECHNICAL_OR_OPERATIONAL_REVIEW" },
        "evidenceShiftType": { "const": "FREE" },
        "matchingMode": { "const": "ONE_TO_ONE_EARLIEST_DEADLINE" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "legalRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingTime", "breaks", "nightWork", "restPeriod", "planning"],
      "properties": {
        "workingTime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "standardDailyMinutes",
            "maxDailyMinutes",
            "nightAverageMinutes",
            "workWeekLastDay",
            "absenceWorkdaysPerWeek",
            "grossPlanningWarningMinutes",
            "sourceIds"
          ],
          "properties": {
            "standardDailyMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
            "maxDailyMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
            "nightAverageMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
            "workWeekLastDay": { "type": "integer", "minimum": 1, "maximum": 7 },
            "absenceWorkdaysPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
            "standardAverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["calendarMonths", "weeks", "assessmentMode", "neutralAbsenceTypes"],
              "properties": {
                "calendarMonths": { "type": "integer", "minimum": 1, "maximum": 24 },
                "weeks": { "type": "integer", "minimum": 1, "maximum": 104 },
                "assessmentMode": { "const": "FORWARD_FROM_EXTENDED_WORKDAY" },
                "neutralAbsenceTypes": { "const": ["VACATION", "SICK"] }
              }
            },
            "grossPlanningWarningMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2880
            },
            "sourceIds": { "$ref": "#/$defs/sourceIds" }
          }
        },
        "breaks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumSegmentMinutes", "tiers", "sourceIds"],
          "properties": {
            "minimumSegmentMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
            "tiers": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/breakTier" }
            },
            "sourceIds": { "$ref": "#/$defs/sourceIds" }
          }
        },
        "nightWork": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startMinute",
            "endMinute",
            "qualification",
            "averageWindowDays",
            "sourceIds"
          ],
          "properties": {
            "startMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
            "endMinute": { "type": "integer", "minimum": 0, "maximum": 1439 },
            "qualification": {
              "type": "object",
              "additionalProperties": false,
              "required": ["comparator", "thresholdMinutes"],
              "properties": {
                "comparator": { "enum": ["GT", "GTE", "EQ"] },
                "thresholdMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
              }
            },
            "workerQualification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "regularRotatingNightWorkRequiresConfirmation",
                "annualNightWorkDaysThreshold"
              ],
              "properties": {
                "regularRotatingNightWorkRequiresConfirmation": { "const": true },
                "annualNightWorkDaysThreshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 366
                }
              }
            },
            "averageWindowDays": {
              "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 366 }]
            },
            "sourceIds": { "$ref": "#/$defs/sourceIds" }
          }
        },
        "restPeriod": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultMinutes", "deviations", "sourceIds"],
          "properties": {
            "defaultMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
            "deviations": {
              "type": "array",
              "items": { "$ref": "#/$defs/restDeviation" }
            },
            "sourceIds": { "$ref": "#/$defs/sourceIds" }
          }
        },
        "sundayHolidayRest": { "$ref": "#/$defs/sundayHolidayRest" },
        "planning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consecutiveWorkDaysWarning",
            "consecutiveNightShiftsWarning",
            "consecutiveWeekendGapDays",
            "lateEarlyDayGap",
            "sourceIds"
          ],
          "properties": {
            "consecutiveWorkDaysWarning": { "type": "integer", "minimum": 1 },
            "consecutiveNightShiftsWarning": { "type": "integer", "minimum": 1 },
            "consecutiveWeekendGapDays": { "type": "integer", "minimum": 1 },
            "lateEarlyDayGap": { "type": "integer", "minimum": 1 },
            "sourceIds": { "$ref": "#/$defs/sourceIds" }
          }
        }
      }
    },
    "legalPackage": {
      "allOf": [
        { "$ref": "#/$defs/packageBase" },
        {
          "type": "object",
          "required": ["kind", "rules"],
          "properties": {
            "engineContractVersion": { "enum": [1, 3, 4, 5, 6] },
            "kind": { "const": "LEGAL" },
            "rules": { "$ref": "#/$defs/legalRules" }
          }
        }
      ]
    },
    "holiday": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scope",
        "federalStates",
        "validFrom",
        "validTo",
        "calculation",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "scope": { "enum": ["NATIONWIDE", "STATEWIDE", "REGIONAL"] },
        "federalStates": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/federalState" }
            }
          ]
        },
        "regionIds": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            }
          ]
        },
        "validFrom": { "$ref": "#/$defs/isoDate" },
        "validTo": { "$ref": "#/$defs/nullableDate" },
        "calculation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "month", "day"],
              "properties": {
                "type": { "const": "FIXED_DATE" },
                "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                "day": { "type": "integer", "minimum": 1, "maximum": 31 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "offsetDays"],
              "properties": {
                "type": { "const": "EASTER_OFFSET" },
                "offsetDays": { "type": "integer", "minimum": -100, "maximum": 100 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "REPENTANCE_DAY" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "date"],
              "properties": {
                "type": { "const": "SPECIFIC_DATE" },
                "date": { "$ref": "#/$defs/isoDate" }
              }
            }
          ]
        },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "holidayRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holidays"],
      "properties": {
        "holidays": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/holiday" }
        }
      }
    },
    "holidayPackage": {
      "allOf": [
        { "$ref": "#/$defs/packageBase" },
        {
          "type": "object",
          "required": ["kind", "rules"],
          "properties": {
            "engineContractVersion": { "enum": [1, 2, 7] },
            "kind": { "const": "HOLIDAY" },
            "rules": { "$ref": "#/$defs/holidayRules" }
          }
        }
      ]
    }
  }
}
