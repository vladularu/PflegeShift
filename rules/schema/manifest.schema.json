{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pflegeshift.app/schemas/rule-manifest-v1.json",
  "title": "PflegeShift Rule Manifest",
  "description": "Signed, immutable catalog of rule packages available to an app installation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generation",
    "channel",
    "publishedAt",
    "rollbackOfGeneration",
    "tracks",
    "packages",
    "signing"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "channel": { "enum": ["PREVIEW", "PRODUCTION"] },
    "publishedAt": { "$ref": "#/$defs/utcTimestamp" },
    "rollbackOfGeneration": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packageDescriptor" }
    },
    "signing": { "$ref": "#/$defs/signing" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "versionIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9A-Za-z]+(?:[._-][0-9A-Za-z]+)*$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$"
    },
    "kind": { "enum": ["TARIFF", "LEGAL", "HOLIDAY"] },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "kind", "coverageFrom", "coverageTo", "coverage"],
      "properties": {
        "packageId": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/kind" },
        "coverageFrom": { "$ref": "#/$defs/isoDate" },
        "coverageTo": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/isoDate" }]
        },
        "coverage": { "enum": ["COMPLETE", "PARTIAL"] }
      }
    },
    "packageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "versionId",
        "kind",
        "engineContractVersion",
        "validFrom",
        "validTo",
        "path",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "packageId": { "$ref": "#/$defs/identifier" },
        "versionId": { "$ref": "#/$defs/versionIdentifier" },
        "kind": { "$ref": "#/$defs/kind" },
        "engineContractVersion": { "const": 1 },
        "validFrom": { "$ref": "#/$defs/isoDate" },
        "validTo": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/isoDate" }]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^packages/[a-z0-9.-]+/[0-9A-Za-z._-]+\\.json$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 524288 }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "keyId", "signature"],
      "properties": {
        "algorithm": { "const": "ED25519" },
        "canonicalization": { "const": "RFC8785" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "signature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
