{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pflegeshift.app/schemas/rule-catalog-publication-request-v1.json",
  "title": "PflegeShift Rule Catalog Publication Request",
  "description": "Administrative input for producing one signed, immutable rule-catalog generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generation",
    "channel",
    "publishedAt",
    "rollbackOfGeneration",
    "packageSources",
    "signing"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "channel": {
      "enum": ["PREVIEW", "PRODUCTION"]
    },
    "publishedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "rollbackOfGeneration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "packageSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^rules/packages/reviewed/[a-z0-9.-]+/[0-9A-Za-z._-]+\\.json$"
      }
    },
    "signing": {
      "$ref": "#/$defs/signing"
    },
    "legacyTariffPackageId": {
      "description": "Schema v2: explicit tariff track for existing profiles without a tariff identifier; never a fallback for an explicitly requested tariff.",
      "$ref": "#/$defs/identifier"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$"
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "keyId"],
      "properties": {
        "algorithm": {
          "const": "ED25519"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": ["legacyTariffPackageId"],
        "properties": {
          "legacyTariffPackageId": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "else": {
        "properties": {
          "legacyTariffPackageId": false
        }
      }
    }
  ]
}
