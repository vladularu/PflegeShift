{
  "expo": {
    "name": "LUNA Shift",
    "slug": "pflegeshift",
    "description": "Lokaler Dienstplaner mit Arbeitszeit- und TVöD-P-Auswertung.",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pflegeshift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.pflegeshift.app",
      "buildNumber": "1",
      "runtimeVersion": "ios-2026.09.1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2E766F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pflegeshift.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EC",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#111315"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "./plugins/with-native-tab-transitions",
      "./plugins/with-local-notifications-only"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "010fe78f-de53-42b8-9635-a73ea099b5fc"
      }
    },
    "owner": "vladularu",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/010fe78f-de53-42b8-9635-a73ea099b5fc"
    }
  }
}
